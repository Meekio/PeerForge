# PeerForge - Root .gitignore

# Environment Variables (CRITICAL - Contains secrets!)
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Database files
*.db
*.sqlite
*.sqlite3
peerforge.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.log

# Virtual Environment
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Node modules (CRITICAL - Never commit!)
node_modules/
**/node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/

# OS
Thumbs.db
.DS_Store

# Uploaded files
backend/sample_ids/*
!backend/sample_ids/.gitkeep
backend/student_id/v*/sample_ids/*.pdf
backend/student_id/v*/sample_ids/*.jpg
backend/student_id/v*/sample_ids/*.png

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.coverage
htmlcov/
.pytest_cache/

# Temporary files
*.tmp
*.temp
.cache/
